{
  "name": "max-career-navigator",
  "version": "0.1.0",
  "private": true,
  "description": "Чат-бот «Твой карьерный навигатор» для MAX — цифровой карьерный профиль для студентов и выпускников (хакатон «Забота о людях»)",
  "type": "module",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=certs/russian_trusted_ca_bundle.pem tsx watch src/bot.ts",
    "start": "NODE_EXTRA_CA_CERTS=certs/russian_trusted_ca_bundle.pem node dist/bot.js",
    "build": "tsc -p tsconfig.json",
    "test": "BOT_TOKEN=test DELETE_INTERVAL_MS=0 SUBMISSIONS_FILE=/tmp/max-career-navigator-test-submissions.json node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@maxhub/max-bot-api": "0.3.1",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "tsx": "4.23.15"
  }
}
